APP_ENV=production
HTTP_PORT=80

MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=itam_system
MYSQL_USER=itam
MYSQL_PASSWORD=change-this-db-password
MYSQL_MAX_CONNECTIONS=200
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_TIMEZONE=+08:00

DB_HOST=mysql
DB_PORT=3306
DB_NAME=itam_system
DB_USER=itam
DB_PASSWORD=change-this-db-password
DB_CHARSET=utf8mb4
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

JWT_SECRET=change-this-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=480
JWT_REMEMBER_EXPIRE_DAYS=30
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

INITIAL_ADMIN_PASSWORD=change-this-admin-password
INITIAL_AUDITOR_PASSWORD=change-this-auditor-password
INIT_DATABASE_TOKEN=change-this-init-database-token

CORS_ORIGINS=https://itam.example.com
WEB_CONCURRENCY=2
WEB_TIMEOUT=120

MAX_ASSETS_PER_USER=5
HIGH_VALUE_THRESHOLD=50000
IDLE_DAYS_THRESHOLD=90
ASSET_RESIDUAL_RATE=0.05

MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

VITE_MOBILE_PUBLIC_URL=
VITE_FEISHU_SDK_URL=
VITE_FEISHU_SDK_AUTO_LOAD=
