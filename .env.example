MYSQL_ROOT_PASSWORD=itam_root
MYSQL_DATABASE=itam_system
MYSQL_USER=itam
MYSQL_PASSWORD=itam_pass
DATABASE_URL=mysql+pymysql://itam:itam_pass@mysql:3306/itam_system?charset=utf8mb4
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_AUDITOR_PASSWORD=Auditor@123456
ASSET_RESIDUAL_RATE=0.05
JWT_SECRET=change-me-in-production
JWT_REMEMBER_EXPIRE_DAYS=30
# 生产部署请使用 docker-compose.prod.yml 并设置强随机 JWT_SECRET / INIT_DATABASE_TOKEN / 数据库密码
INIT_DATABASE_TOKEN=dev-init-token
VITE_ALLOWED_HOSTS=
VITE_MOBILE_PUBLIC_URL=
VITE_FEISHU_SDK_URL=
VITE_FEISHU_SDK_AUTO_LOAD=
