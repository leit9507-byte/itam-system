FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_API_BASE_URL=/backend
ARG VITE_API_TIMEOUT_MS=30000
ARG VITE_MOBILE_PUBLIC_URL=
ARG VITE_FEISHU_SDK_URL=
ARG VITE_FEISHU_SDK_AUTO_LOAD=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_API_TIMEOUT_MS=${VITE_API_TIMEOUT_MS}
ENV VITE_MOBILE_PUBLIC_URL=${VITE_MOBILE_PUBLIC_URL}
ENV VITE_FEISHU_SDK_URL=${VITE_FEISHU_SDK_URL}
ENV VITE_FEISHU_SDK_AUTO_LOAD=${VITE_FEISHU_SDK_AUTO_LOAD}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
